    function loadCurrentQuestion() {
      const q = currentBattle.questions[currentBattle.questionIndex];
      currentBattle.currentQ = q;

      document.getElementById('question-category').innerText = `${currentBattle.floor}F ${q.category}`;
      document.getElementById('question-count').innerText = `第 ${currentBattle.questionIndex + 1} / ${currentBattle.questions.length} 題`;
      document.getElementById('question-text').innerText = q.question;

      const optsContainer = document.getElementById('options-container');
      optsContainer.innerHTML = '';

      q.options.forEach((optText, optIdx) => {
        const btn = document.createElement('button');
        btn.className = "option-btn w-full p-2.5 bg-slate-800 hover:bg-slate-700 active:bg-purple-900 border border-slate-700 rounded-xl text-xs text-left text-slate-200 leading-relaxed font-medium transition-all shadow";
        btn.id = `opt-btn-${optIdx}`;
        btn.innerText = optText;
        btn.onclick = () => submitAnswer(optIdx);
        optsContainer.appendChild(btn);
      });

      document.getElementById('enemy-buff-badge').classList.add('hidden');
      updateSkillButtons();
    }

    function submitAnswer(chosenIdx) {
      const q = currentBattle.currentQ;
      const isCorrect = chosenIdx === q.answer;

      if (isCorrect) {
        playSound('correct');
        let dmg = player.atk + Math.floor(Math.random() * 10);
        if (currentBattle.critActive) {
          dmg = Math.floor(dmg * 2.5);
          currentBattle.critActive = false;
        }

        currentBattle.enemyHp = Math.max(0, currentBattle.enemyHp - dmg);
        showFloatingDamage(`-${dmg} CRITICAL!`, 'text-amber-400 font-extrabold text-2xl');
        setBattleToast(`🎯 答對了！法術命中對手，造成 ${dmg} 點傷害！`);
        updateBattleStats();

        showExplanationModal(true, q);
      } else {
        playSound('wrong');
        const enemyAtk = MONSTERS[currentBattle.floor].atk;
        player.hp = Math.max(0, player.hp - enemyAtk);
        
        document.getElementById('main-container').classList.add('shake-animation');
        setTimeout(() => document.getElementById('main-container').classList.remove('shake-animation'), 400);

        showFloatingDamage(`-${enemyAtk} HP`, 'text-red-500 font-bold text-xl');
        setBattleToast(`❌ 答錯受創！遭魔物反擊受到 ${enemyAtk} 點傷害！`);
        
        // Add to mistake vault
        if (!player.mistakes.some(m => m.id === q.id)) {
          player.mistakes.push(q);
          saveGameData();
        }

        updateHUD();
        updateBattleStats();
        showExplanationModal(false, q);
      }
    }

