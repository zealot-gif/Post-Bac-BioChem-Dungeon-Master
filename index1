    function nextQuestionAfterExplanation() {
      closeModal('modal-explanation');

      if (player.hp <= 0) {
        alert("你體力不支敗下陣來！請補充丹藥後重新挑戰！");
        player.hp = player.maxHp;
        updateHUD();
        exitBattle();
        return;
      }

      if (currentBattle.enemyHp <= 0) {
        // Floor Defeated
        const m = MONSTERS[currentBattle.floor];
        player.gold += m.gold;
        addExp(m.exp);
        
        if (currentBattle.floor === player.unlockedFloor && player.unlockedFloor < 5) {
          player.unlockedFloor++;
        }

        saveGameData();
        alert(`恭喜擊敗 ${m.name}！獲得 金幣 +${m.gold}、EXP +${m.exp}！`);
        exitBattle();
        return;
      }

      currentBattle.questionIndex = (currentBattle.questionIndex + 1) % currentBattle.questions.length;
      loadCurrentQuestion();
    }

