        playSound('levelUp');
        player.level++;
        player.exp -= player.maxExp;
        player.maxExp = Math.floor(player.maxExp * 1.3);
        player.maxHp += 15;
        player.hp = player.maxHp;
        player.atk += 8;
        alert(`🎉 恭喜突破升級至 Lv.${player.level}！生命值與攻擊力大幅提升！`);
      }
      updateHUD();
    }

    /* Shop Logic */
    function openShopModal() { playSound('hit'); openModal('modal-shop'); }
    function buyItem(type, cost) {
      if (player.gold >= cost) {
        playSound('correct');
        player.gold -= cost;
        player.items[type]++;
        updateHUD();
        updateSkillButtons();
        saveGameData();
        alert("購買成功！");
      } else {
        playSound('wrong');
        alert("金幣不足！請先通關試煉獲取金幣。");
      }
    }

    /* Mistake Vault Modal */
    function openMistakeModal() {
      playSound('hit');
      const container = document.getElementById('mistakes-list-container');
      container.innerHTML = '';

      if (player.mistakes.length === 0) {
        container.innerHTML = '<div class="text-center text-slate-500 my-8 text-xs">目前沒有錯題紀錄！繼續保持！</div>';
      } else {
        player.mistakes.forEach((m, idx) => {
          const item = document.createElement('div');
          item.className = "bg-slate-950 border border-slate-800 p-3 rounded-xl space-y-1.5";
          item.innerHTML = `
            <div class="text-[10px] text-purple-400 font-bold">#${idx + 1} ${m.category}</div>
            <div class="text-xs font-bold text-slate-200">${m.question}</div>
            <div class="text-xs text-amber-300 font-bold">正確答案：${m.options[m.answer]}</div>
            <div class="text-[11px] text-slate-400 border-t border-slate-900 pt-1 leading-relaxed">${m.explanation}</div>
          `;
          container.appendChild(item);
        });
      }

      openModal('modal-mistakes');
    }

    function clearMistakes() {
      player.mistakes = [];
      saveGameData();
      updateHUD();
      openMistakeModal();
    }

    function openModal(id) { document.getElementById(id).classList.remove('hidden'); }
    function closeModal(id) { playSound('hit'); document.getElementById(id).classList.add('hidden'); }
  </script>
</body>
</html>
