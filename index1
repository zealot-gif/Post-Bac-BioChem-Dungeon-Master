  <!-- JAVASCRIPT GAME ENGINE & QUESTION BANK -->
  <script>
    /* ==================== POST-BAC BIOCHEM QUESTION BANK ==================== */
    const QUESTION_BANK = {
      floor1: [
        {
          id: 'f1_1',
          category: '細胞生物學',
          question: '有關真核細胞 Centriole（中心粒）與 Cilia（纖毛）之微管結構排列 (Microtubule arrangement)，下列何者正確？',
          options: [
            'A. 中心粒為 9+2 三聯管，纖毛為 9+0 二聯管',
            'B. 中心粒為 9+0 三聯管，纖毛基底體 (Basal body) 為 9+2 二聯管',
            'C. 中心粒為 9+0 三聯管，軸絲 (Axoneme) 構造為 9+2 二聯管',
            'D. 中心粒與纖毛軸絲皆為 9+2 二聯管結構'
          ],
          answer: 2, // C
          explanation: '【考點解析】中心粒 (Centriole) 與基底體 (Basal body) 均是由 9 組三聯管圍成的 9+0 結構；而纖毛與鞭毛的軸絲 (Axoneme) 則是由 9 組雙聯管加上中央 2 支單管組成的 9+2 構造。'
        },
        {
          id: 'f1_2',
          category: '分子生物學',
          question: '真核細胞進行 Translation（轉譯）作用時，起始複合體 (Initiation complex) 的形成與第一個 tRNA 的結合，下列敘述何者正確？',
          options: [
            'A. 第一個進入 A site 的胺基酸為 Formyl-methionine (fMet)',
