  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Google Fonts: Silkscreen & Noto Sans TC -->
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700;900&family=Silkscreen:wght@400;700&display=swap" rel="stylesheet">
  
  <style>
    body {
      font-family: 'Noto Sans TC', sans-serif;
      user-select: none;
      -webkit-user-select: none;
      touch-action: manipulation;
      background-color: #070913;
      color: #f1f5f9;
    }

    .font-pixel {
      font-family: 'Silkscreen', 'Noto Sans TC', monospace;
    }

    /* Retro Pixel UI Borders */
    .pixel-box {
      border: 4px solid #1e293b;
      box-shadow: 
        -4px 0 0 0 #334155,
        4px 0 0 0 #334155,
        0 -4px 0 0 #334155,
        0 4px 0 0 #334155;
    }

    .pixel-btn {
      transition: all 0.1s ease;
      position: relative;
    }
    .pixel-btn:active {
      transform: translateY(2px);
    }

    /* Health and Mana Bars */
    .bar-glow-hp {
      box-shadow: 0 0 10px rgba(239, 68, 68, 0.6);
    }
    .bar-glow-exp {
      box-shadow: 0 0 10px rgba(168, 85, 247, 0.6);
    }

    /* Floating Damage Text Animation */
    @keyframes floatDamage {
      0% { opacity: 1; transform: translateY(0) scale(1); }
      50% { transform: translateY(-25px) scale(1.3); }
      100% { opacity: 0; transform: translateY(-50px) scale(0.9); }
    }
    .floating-damage {
      animation: floatDamage 0.9s cubic-bezier(0.18, 0.89, 0.32, 1.28) forwards;
    }

    /* Screen Shake Animation on Damage */
    @keyframes screenShake {
      0%, 100% { transform: translate(0, 0); }
      20% { transform: translate(-6px, 4px); }
      40% { transform: translate(6px, -4px); }
      60% { transform: translate(-4px, -2px); }
      80% { transform: translate(4px, 2px); }
    }
    .shake-animation {
      animation: screenShake 0.35s ease-in-out;
    }

    /* Enemy Idle Bounce */
    @keyframes enemyFloat {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-8px); }
    }
    .enemy-bounce {
      animation: enemyFloat 2.5s ease-in-out infinite;
    }

    /* Safe Area Adaptations */
    .pb-safe {
      padding-bottom: env(safe-area-inset-bottom, 0.75rem);
    }
  </style>
</head>
