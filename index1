    /* Skills Implementation */
    function useSkill(type) {
      if (type === 'hint' && player.items.hint > 0) {
        player.items.hint--;
        const q = currentBattle.currentQ;
        let removed = 0;
        q.options.forEach((_, idx) => {
          if (idx !== q.answer && removed < 2) {
            const btn = document.getElementById(`opt-btn-${idx}`);
            if (btn) btn.style.display = 'none';
            removed++;
          }
        });
        document.getElementById('enemy-buff-badge').classList.remove('hidden');
        setBattleToast("📖 啟用考前筆記，已剔除兩個錯誤選項！");
      } else if (type === 'heal' && player.items.heal > 0) {
        player.items.heal--;
        const healAmt = Math.floor(player.maxHp * 0.5);
        player.hp = Math.min(player.maxHp, player.hp + healAmt);
        showFloatingDamage(`+${healAmt} HP`, 'text-emerald-400 font-bold text-xl');
        setBattleToast(`🧪 服用靈芝草藥，恢復了 ${healAmt} 點生命值！`);
      } else if (type === 'crit' && player.items.crit > 0) {
        player.items.crit--;
        currentBattle.critActive = true;
        setBattleToast("⚡ 激發分子暴擊！下一次答對傷害加倍！");
